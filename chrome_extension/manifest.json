{
  "manifest_version": 3,
  "name": "에이블런 GPT 계정 추가",
  "version": "1.7",
  "description": "에이블런 Google Groups에 GPT 계정 멤버를 엑셀 복사/붙여넣기로 일괄 자동 등록하는 도구입니다.",
  "permissions": [
    "scripting",
    "activeTab",
    "debugger",
    "notifications",
    "storage"
  ],
  "host_permissions": [
    "https://groups.google.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  },
  "background": {
    "service_worker": "background.js"
  }
}